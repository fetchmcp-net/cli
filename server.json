{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "net.fetchmcp/fetchmcp",
  "title": "FetchMCP API",
  "description": "Fetch public web pages live and get clean Markdown, text or HTML.",
  "version": "0.1.0",
  "websiteUrl": "https://fetchmcp.net/docs/mcp",
  "icons": [
    {
      "src": "https://fetchmcp.net/site-assets/fetchmcp-net/icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://fetchmcp.net/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your FetchMCP API key as a bearer token: Bearer 1337_live_…",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
